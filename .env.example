# ========================================================
# SOHAM NGO - Environment Configuration
# ========================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://sohamngo.com
NEXT_PUBLIC_SITE_NAME="Soham NGO"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Form Notification Service (Optional)
# If using Formspree for email notifications, set your Formspree Form ID:
# e.g. https://formspree.io/f/xyzabwqr -> xyzabwqr
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
NEXT_PUBLIC_FORMSPREE_VOLUNTEER_ID=

# Admin Authentication Secret
ADMIN_JWT_SECRET=soham_ngo_super_secure_jwt_secret_change_in_production_2026

# Database Storage Mode (auto / supabase / local)
# "auto": uses Supabase if credentials are provided, else seamlessly falls back to high-performance local DB
DATABASE_PROVIDER=auto
